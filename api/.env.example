# PostgreSQL (no Railway é preenchida sozinha)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/financeos

# Login pelo Authik
# Endereço de login do FinanceOS (o mesmo do VITE_AUTH_URL do site)
AUTH_URL=https://auth.finance.joaoa.com.br
# Nome interno da aplicação no painel do Authik
AUTH_AUDIENCE=financeos

# Endereço(s) do site que podem chamar a API, separados por vírgula (sem "/" no fim)
FRONTEND_ORIGINS=https://finance.joaoa.com.br

# Opcional: apaga os dados de contas excluídas no Authik (canal servidor do Authik)
# AUTHIK_SERVER_URL=https://api.authik.com.br
# AUTHIK_CLIENT_ID=
# AUTHIK_CLIENT_SECRET=

PORT=3000
NODE_ENV=production
